# EcoWealth Portal — SiteGround / Apache
# Avoid "Options" here — it can cause HTTP 500 on some hosts when AllowOverride is limited.

# Protect sensitive files (Apache 2.4+)
<IfModule mod_authz_core.c>
    <FilesMatch "^(config\.php|composer\.(json|lock)|debug\.log)$">
        Require all denied
    </FilesMatch>
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    <FilesMatch "^(config\.php|composer\.(json|lock)|debug\.log)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
